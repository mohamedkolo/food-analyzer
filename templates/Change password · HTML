{% extends "base.html" %}
{% block title %}تغيير كلمة السر{% endblock %}

{% block content %}
<div class="page-title"><span class="icon">🔐</span> تغيير كلمة السر</div>

{% if success %}
<div class="alert alert-success">✅ تم تغيير كلمة السر بنجاح! استخدم الجديدة في تسجيل الدخول القادم.</div>
{% endif %}

{% if error %}
<div class="alert alert-error" style="background:#fee;color:#8b0000;border:1px solid #fca5a5;padding:10px 14px;border-radius:8px;margin-bottom:12px;">⚠️ {{ error }}</div>
{% endif %}

<div class="card" style="max-width:480px;margin:0 auto;">
  <div class="card-title">🔑 كلمة سر جديدة</div>
  <form method="POST" action="/change-password">
  <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

    <div class="form-group">
      <label class="form-label">كلمة السر الحالية</label>
      <input class="form-input" type="password" name="current_password" required autocomplete="current-password" placeholder="••••••••">
    </div>

    <div class="form-group">
      <label class="form-label">كلمة السر الجديدة</label>
      <input class="form-input" type="password" name="new_password" id="new_pw" required minlength="6" autocomplete="new-password" placeholder="6 أحرف على الأقل">
      <div id="pw_strength" style="font-size:12px;margin-top:4px;"></div>
    </div>

    <div class="form-group">
      <label class="form-label">تأكيد كلمة السر الجديدة</label>
      <input class="form-input" type="password" name="confirm_password" id="confirm_pw" required minlength="6" autocomplete="new-password" placeholder="اكتبها تاني">
      <div id="pw_match" style="font-size:12px;margin-top:4px;"></div>
    </div>

    <button type="submit" class="btn btn-primary btn-full">🔒 تغيير كلمة السر</button>
  </form>
</div>

<div style="text-align:center;margin-top:14px;">
  <a href="/settings" style="font-size:13px;color:#52796f;">↩️ الرجوع للإعدادات</a>
</div>

<script>
// مؤشر بسيط لقوة كلمة السر ومطابقة التأكيد — بيشتغل وأنت بتكتب
const newPw = document.getElementById('new_pw');
const confirmPw = document.getElementById('confirm_pw');
const strengthEl = document.getElementById('pw_strength');
const matchEl = document.getElementById('pw_match');

newPw.addEventListener('input', () => {
  const v = newPw.value;
  let score = 0;
  if (v.length >= 6) score++;
  if (v.length >= 10) score++;
  if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
  if (/\d/.test(v)) score++;
  if (/[^A-Za-z0-9]/.test(v)) score++;
  if (!v) { strengthEl.textContent = ''; return; }
  if (score <= 1)      { strengthEl.textContent = '🔴 ضعيفة';   strengthEl.style.color = '#c0392b'; }
  else if (score <= 3) { strengthEl.textContent = '🟡 متوسطة';  strengthEl.style.color = '#b7791f'; }
  else                 { strengthEl.textContent = '🟢 قوية';    strengthEl.style.color = '#2d7d46'; }
});

confirmPw.addEventListener('input', () => {
  if (!confirmPw.value) { matchEl.textContent = ''; return; }
  if (confirmPw.value === newPw.value) { matchEl.textContent = '✅ متطابقة'; matchEl.style.color = '#2d7d46'; }
  else { matchEl.textContent = '❌ غير متطابقة'; matchEl.style.color = '#c0392b'; }
});
</script>
{% endblock %}
